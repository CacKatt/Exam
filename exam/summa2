import socket
import threading

HOST = "127.0.0.1"
PORT = 5001


def handle_request(data, address, server):
    domain = data.decode()

    print("Root Server received:", domain)

    if domain.endswith(".com"):
        response = "TLD"
    else:
        response = "NOT_FOUND"

    server.sendto(response.encode(), address)


server = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
server.bind((HOST, PORT))

print("Root DNS Server running on UDP port", PORT)

while True:
    data, address = server.recvfrom(1024)

    thread = threading.Thread(
        target=handle_request,
        args=(data, address, server)
    )

    thread.start()



