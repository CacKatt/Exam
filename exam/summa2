#local_dns_iterative.py
import socket
import threading

HOST = "127.0.0.1"
PORT = 5000


def query_server(port, domain):

    client = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)

    client.sendto(
        domain.encode(),
        (HOST, port)
    )

    response, address = client.recvfrom(1024)

    client.close()

    return response.decode()


def handle_client(data, address, server):

    domain = data.decode()

    print("\nLocal DNS received:", domain)

    # Step 1: Ask Root
    response = query_server(5001, domain)

    print("Root replied:", response)

    if response != "TLD":
        server.sendto(
            "Domain not found".encode(),
            address
        )
        return

    # Step 2: Ask TLD
    response = query_server(5002, domain)

    print("TLD replied:", response)

    if response != "AUTHORITATIVE":
        server.sendto(
            "Domain not found".encode(),
            address
        )
        return

    # Step 3: Ask Authoritative
    ip = query_server(5003, domain)

    print("Authoritative replied:", ip)

    # Send final IP to client
    server.sendto(ip.encode(), address)


server = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)

server.bind((HOST, PORT))

print("Local DNS Server running on UDP port", PORT)

while True:

    data, address = server.recvfrom(1024)

    thread = threading.Thread(
        target=handle_client,
        args=(data, address, server)
    )

    thread.start()


