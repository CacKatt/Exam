import socket

HOST = "127.0.0.1"
PORT = 6000

# Create TCP socket
client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

# Set timeout
client.settimeout(2)

# Connect to receiver
client.connect((HOST, PORT))


# ------------------------------------------------
# GET INPUT
# ------------------------------------------------

total_frames = int(
    input("Enter number of frames: ")
)

window_size = int(
    input("Enter window size: ")
)


# ------------------------------------------------
# GO-BACK-N VARIABLES
# ------------------------------------------------

# First unacknowledged frame
base = 0

# Next frame to send
next_frame = 0


# ------------------------------------------------
# SEND FRAMES
# ------------------------------------------------

while base < total_frames:


    # Send all frames in current window
    while (
        next_frame < base + window_size
        and next_frame < total_frames
    ):

        print("Sending Frame:", next_frame)

        client.send(
            str(next_frame).encode()
        )

        next_frame += 1


    try:

        # Wait for ACK
        data = client.recv(1024)

        ack = int(
            data.decode().split()[1]
        )

        print("Received:", data.decode())


        # Move window forward
        base = ack + 1


    except socket.timeout:

        # No ACK received within timeout
        print("\n>>> TIMEOUT!")

        print(
            "Go-Back-N: Retransmitting from Frame",
            base
        )


        # Go back to first unacknowledged frame
        next_frame = base


print("\nAll frames transmitted successfully!")

client.close()
