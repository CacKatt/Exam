import socket
import re

HOST = "127.0.0.1"
PORT = 5000


# -------------------------------
# Validate MAC address
# -------------------------------

def valid_mac(mac):

    # Exactly 6 hexadecimal octets
    pattern = r"^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$"

    return re.match(pattern, mac) is not None


# Create TCP socket
client = socket.socket(
    socket.AF_INET,
    socket.SOCK_STREAM
)

client.connect((HOST, PORT))


# -------------------------------
# Get information from user
# -------------------------------

source_ip = input("Enter Source IP: ")

source_mac = input("Enter Source MAC: ")

destination_ip = input("Enter Destination IP: ")


# Send information to server
message = (
    source_ip + "," +
    source_mac + "," +
    destination_ip
)

client.send(message.encode())


# -------------------------------
# Receive destination IP + MAC
# -------------------------------

reply = client.recv(1024).decode()


# Check server response
if reply == "INVALID_IP":

    print("Invalid Destination IP")
    client.close()
    exit()


if reply == "IP_NOT_FOUND":

    print("Destination IP not found")
    client.close()
    exit()


# Separate IP and MAC
destination_ip, destination_mac = reply.split(",")


print("\nServer returned:")
print("Destination IP :", destination_ip)
print("Destination MAC:", destination_mac)


# -------------------------------
# CLIENT VALIDATES DESTINATION MAC
# -------------------------------

if valid_mac(destination_mac):

    print("Destination MAC is VALID")

else:

    print("Destination MAC is INVALID")

    client.close()
    exit()


# -------------------------------
# DATA EXCHANGE
# -------------------------------

data = input("\nEnter data to send: ")

client.send(data.encode())


# Receive acknowledgement
ack = client.recv(1024).decode()

print("Server:", ack)


client.close()

#arp_server.py
import socket
import threading

HOST = "127.0.0.1"
PORT = 5000

# IP → MAC mapping
arp_table = {
    "192.168.1.10": "AA:AA:AA:AA:AA:10",
    "192.168.1.20": "BB:BB:BB:BB:BB:20",
    "192.168.1.30": "CC:CC:CC:CC:CC:30"
}


def valid_ip(ip):
    # Split IP into 4 parts
    parts = ip.split(".")

    # IPv4 must have exactly 4 parts
    if len(parts) != 4:
        return False

    # Every part must be between 0 and 255
    for part in parts:
        if not part.isdigit():
            return False

        if int(part) < 0 or int(part) > 255:
            return False

    return True


def handle_client(conn):

    # Receive source IP, source MAC and destination IP
    message = conn.recv(1024).decode()

    source_ip, source_mac, destination_ip = message.split(",")

    print("\nRequest received")
    print("Source IP:", source_ip)
    print("Source MAC:", source_mac)
    print("Destination IP:", destination_ip)


    # -------------------------------
    # SERVER VALIDATES DESTINATION IP
    # -------------------------------

    if not valid_ip(destination_ip):

        conn.send("INVALID_IP".encode())

        conn.close()
        return


    # Check whether destination IP exists
    if destination_ip not in arp_table:

        conn.send("IP_NOT_FOUND".encode())

        conn.close()
        return


    # Destination IP is valid
    destination_mac = arp_table[destination_ip]

    print("Destination IP is valid")
    print("Destination MAC:", destination_mac)


    # Send destination IP + MAC to client
    reply = destination_ip + "," + destination_mac

    conn.send(reply.encode())


    # -------------------------------
    # WAIT FOR DATA
    # -------------------------------

    data = conn.recv(1024).decode()

    print("Data received:", data)

    conn.send("Data received successfully".encode())

    conn.close()


# Create TCP server
server = socket.socket(
    socket.AF_INET,
    socket.SOCK_STREAM
)

server.bind((HOST, PORT))

server.listen(5)

print("ARP Server running...")


while True:

    conn, address = server.accept()

    # Create a new thread for every client
    thread = threading.Thread(
        target=handle_client,
        args=(conn,)
    )

    thread.start()


