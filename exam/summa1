#local_dns_iterative.py
import socket
import threading

HOST = "127.0.0.1"
PORT = 5000


def contact_server(port, domain):

    client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

    client.connect((HOST, port))

    client.send(domain.encode())

    response = client.recv(1024).decode()

    client.close()

    return response


def handle_client(conn):

    domain = conn.recv(1024).decode()

    print("\nLocal DNS received:", domain)

    # Step 1: Ask Root Server
    response = contact_server(5001, domain)

    print("Root says:", response)

    if response == "TLD":

        # Step 2: Ask TLD Server
        response = contact_server(5002, domain)

        print("TLD says:", response)

    if response == "AUTHORITATIVE":

        # Step 3: Ask Authoritative Server
        ip = contact_server(5003, domain)

        print("Authoritative says:", ip)

        conn.send(ip.encode())

    else:
        conn.send("Domain not found".encode())

    conn.close()


server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

server.bind((HOST, PORT))

server.listen(5)

print("Local DNS Server running on port", PORT)

while True:

    conn, addr = server.accept()

    thread = threading.Thread(
        target=handle_client,
        args=(conn,)
    )

    thread.start()



