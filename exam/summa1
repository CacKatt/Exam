#root_iterative.py

import socket
import threading

HOST = "127.0.0.1"
PORT = 5001


def handle_client(conn):
    domain = conn.recv(1024).decode()

    print("Root Server received:", domain)

    # Root tells the Local DNS to contact TLD
    conn.send("TLD".encode())

    conn.close()


server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
server.bind((HOST, PORT))
server.listen(5)

print("Root DNS Server running on port", PORT)

while True:
    conn, addr = server.accept()

    thread = threading.Thread(target=handle_client, args=(conn,))
    thread.start()



